# API Configuration
# URL de la API de backend. Cambia esto a tu URL de despliegue o usa localhost para desarrollo
VITE_API_URL=http://localhost:8000

# Ambiente (development, production)
VITE_ENV=development

# Feature Flags
# Habilitar/deshabilitar caché de API
VITE_ENABLE_CACHE=true
# Tiempo de vida del caché en minutos
VITE_CACHE_TTL_MINUTES=5

# Analytics (uso futuro)
VITE_ANALYTICS_ENABLED=false

# Otras configuraciones personalizadas
# VITE_CUSTOM_SETTING=valor 