# Configuración de la API
API_TITLE=API de Visualización del CIS
API_DESCRIPTION=API para visualizar datos del Centro de Investigaciones Sociológicas
API_VERSION=0.1.0

# CORS (Cross-Origin Resource Sharing)
# Separa múltiples orígenes con comas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Expresión regular para permitir orígenes adicionales (opcional)
# CORS_ALLOWED_ORIGIN_REGEX=https://(.*\.)?tudominio\.com

# Archivos
# Nombre del archivo de datos activo por defecto
DEFAULT_DATA_FILE=estudio_ejemplo.sav
# Directorio para almacenar los archivos de datos
DATA_DIRECTORY=./data

# Logging
LOG_LEVEL=INFO
# Ruta al archivo de registro (opcional, comentar para usar stdout)
# LOG_FILE=./debug.log

# Seguridad (para futuras implementaciones)
# SECRET_KEY=tu_clave_secreta_aqui

# Otras configuraciones
# Puerto para el servidor (utilizado por algunas plataformas de despliegue)
PORT=8000 